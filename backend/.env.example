MA_DB_PATH=data/marketing_agent.db
MA_LLM_BASE_URL=http://localhost:8700/v1
MA_LLM_API_KEY=changeme
MA_LLM_MODEL=marketing-agent
MA_LLM_TIMEOUT_S=300
MA_SEED_DEMO_DATA=1
# 의미 임베딩 검색(opt-in) — 켜기 전에 `pip install -e ".[embeddings]"`로
# fastembed를 설치해야 한다. 꺼져 있으면 BM25 단독 검색으로 항상 동작한다.
MA_EMBEDDINGS=0
# MA_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
